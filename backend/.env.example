# Render provides this automatically when you attach a Postgres database.
# Format: postgres://user:password@host:port/dbname
DATABASE_URL=

# The deployed frontend URL, for CORS. Comma-separate multiple origins.
FRONTEND_URL=http://localhost:5173

# Any long random string. Generate one with: openssl rand -hex 32
JWT_SECRET=

# Get a free key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Render sets PORT automatically — leave blank locally to use 8080
PORT=8080
